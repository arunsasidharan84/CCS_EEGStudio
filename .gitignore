# ── OS artefacts ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ──────────────────────────────────────────────────────────
*.class
*.swp
.atom/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code (uncomment if you do NOT want to share launch configs)
# .vscode/

# ── Flutter / Dart / Pub ───────────────────────────────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication & obfuscation map files (generated per build, not committed)
app.*.symbols
app.*.map.json

# ── Rust ──────────────────────────────────────────────────────────────────
bridge/target/
# Keep Cargo.lock for reproducible builds (binary crate)
# !bridge/Cargo.lock  ← uncomment this line only if you want to ignore it

# ── Build outputs & distribution packages ────────────────────────────────
/dist/
*.deb
*.rpm
*.exe
*.zip
*.app

# ── Test artefacts & large binary parity data ─────────────────────────────
# These large binary/JSON files are generated by parity scripts and should
# not be committed; commit only the scripts and fixtures, not the outputs.
parity_test/*.npy
parity_test/*.json
parity_test/rs_filter.json
parity_test/py_data_for_rust.json
parity_test/step1/
parity_test/step2/
parity_test/gedai/
test_python.log

# ── Local scratch binaries (built from loose .rs files in root) ───────────
test_rust_calc_g
test_rust_leg

# ── Python cache ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── Temporary / scratch ───────────────────────────────────────────────────
tmp_exact_test/
test_chol/
reports/
*.log

# ── Android Studio (unused but generated by Flutter init) ─────────────────
/android/app/debug
/android/app/profile
/android/app/release
